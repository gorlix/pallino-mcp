{
  "name": "@pallino.me/mcp",
  "version": "0.2.0",
  "description": "MCP server for Pallino Cloud: spaces, projects, notes and tasks via the agent API. stdio, Streamable HTTP and OAuth.",
  "type": "module",
  "license": "MIT",
  "author": "gorlix",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gorlix/pallino-mcp.git"
  },
  "homepage": "https://github.com/gorlix/pallino-mcp#readme",
  "mcpName": "io.github.gorlix/pallino-mcp",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pallino",
    "notes",
    "tasks",
    "claude"
  ],
  "bin": {
    "pallino-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
